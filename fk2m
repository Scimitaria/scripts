#!/bin/zsh
zmodload zsh/mathfunc

# Using the fibonacci sequence to convert between miles and kilometers

m2k(){ printf "Direct calculation: %.1f kilometers\n" $(( $1 * 1.609344 )); }
k2m(){ printf "Direct calculation: %.1f miles\n" $(( $1 / 1.609344 )); }

m2k_fib_sequential(){
    fib=( 0 1 )

    for _ in {0..$1}; do
        next=$(( $fib[-1] + $fib[-2] ));
        if [ $next -eq $1 ]; then
            km=$(( $fib[-1] + $next ))
            echo "Fibonacci conversion: $km kilometers"
            return
        fi
        fib+=$next
    done

    echo "Error: Specified number not found in the Fibonacci sequence" >&2
    exit 1
}
k2m_fib_sequential(){
    fib=( 0 1 )

    for _ in {0..$1}; do
        next=$(( $fib[-1] + $fib[-2] ));
        if [ $next -eq $1 ]; then
            mi="$fib[-1]"
            echo "Fibonacci conversion: $mi miles"
            return
        fi
        fib+=$next
    done

    echo "Error: Specified number not found in the Fibonacci sequence" >&2
    exit 1
}

m2k_fib_const(){
    phi=$(( (1.0 + sqrt(5.0)) / 2.0 ))
    prev=$(( int($1 / $phi + 0.5) ))
    km=$(( $1 + $prev))
    echo "Fibonacci conversion: $km kilometers"
}
k2m_fib_const(){
    phi=$(( (1.0 + sqrt(5.0)) / 2.0 ))
    mi=$(( int($1 / $phi + 0.5) ))
    echo "Fibonacci conversion: $mi miles"
}

if (( ${${(e):-(m mi miles)}[(Ie)$2]} )); then
    m2k $1
    #m2k_fib_sequential $1
    m2k_fib_const $1
else
    k2m $1
    #k2m_fib_sequential $1
    k2m_fib_const $1
fi
